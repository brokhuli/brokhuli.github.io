---
/*
 * Footer - palette pair selector, closing line, and license note.
 *
 * Specs:
 *   references/specs/component-spec.md §1 Footer
 *   references/specs/open-items.md (footer copy decision)
 */

import ThemePairSelector from "./ThemePairSelector.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <ThemePairSelector />
  <p class="footer__line">
    © {year} Stephen Ullom · code <a
      href="https://github.com/brokhuli/brokhuli.github.io/blob/main/LICENSE"
      target="_blank"
      rel="noopener noreferrer">MIT</a
    >, content <a
      href="https://github.com/brokhuli/brokhuli.github.io/blob/main/CONTENT-LICENSE.md"
      target="_blank"
      rel="noopener noreferrer">all rights reserved</a
    >
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    /* Clear the fixed sidebar, matching .page-main's content column. */
    margin-left: calc(var(--space-4) + var(--layout-sidebar-width));
    padding: var(--space-8) var(--layout-gutter-desktop);
    margin-top: var(--space-16);
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
  }

  @media (max-width: 768px) {
    .footer {
      margin-left: 0;
    }
  }

  .footer__line {
    margin: 0;
  }

  .footer__line a {
    color: var(--color-fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 2px;
  }

  .footer__line a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .footer {
      padding: var(--space-6) var(--layout-gutter-mobile);
    }
  }
</style>
