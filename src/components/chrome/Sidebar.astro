---
/*
 * Sidebar — persistent left-rail navigation, floating chrome.
 *
 * Specs:
 *   references/specs/component-spec.md §1 Sidebar
 *   references/specs/interaction-spec.md §3
 *
 * Strategy: pure .astro with one colocated script tag (no client:* needed)
 * driving an IntersectionObserver for the active-section highlight.
 */

import Icon from "../primitives/Icon.astro";

// `mobileHref` overrides the in-page anchor on narrow viewports — Projects
// and Experience sections are hidden on mobile, so the sidebar routes those
// clicks to their dedicated pages instead.
const items: {
  id: string;
  label: string;
  icon: string;
  mobileHref?: string;
}[] = [
  { id: "home", label: "Home", icon: "lucide:home" },
  { id: "about", label: "About", icon: "lucide:user" },
  {
    id: "projects",
    label: "Projects",
    icon: "lucide:layout-grid",
    mobileHref: "/projects/",
  },
  { id: "architecture", label: "Architecture", icon: "lucide:cuboid" },
  {
    id: "experience",
    label: "Experience",
    icon: "lucide:briefcase",
    mobileHref: "/resume",
  },
  { id: "tech-stack", label: "Tech Stack", icon: "lucide:square-stack" },
  { id: "contact", label: "Contact", icon: "lucide:mail" },
];

import pkg from "../../../package.json";
const versionLabel = `v${pkg.version}`;

// Pathname-based active item so dedicated pages (/projects/, /resume) keep
// the matching sidebar entry highlighted. On the index page we fall back to
// the scroll-spy script, which takes over from the SSR'd "home" default.
const path = Astro.url.pathname;
const activeId = path.startsWith("/projects")
  ? "projects"
  : path.startsWith("/resume")
    ? "experience"
    : "home";
---

<nav class="sidebar" aria-label="Primary">
  <ul class="sidebar__list" role="list">
    {
      items.map((item) => {
        const anchorHref = item.id === "home" ? "/" : `/#${item.id}`;
        const ariaCurrent = item.id === activeId ? "location" : undefined;
        return (
          <li
            class:list={[
              "sidebar__item",
              item.id === "architecture" && "hide-on-mobile",
              item.mobileHref && "sidebar__item--mobile-tail",
            ]}
          >
            <a
              class:list={[
                "sidebar__link",
                item.mobileHref && "hide-on-mobile",
              ]}
              href={anchorHref}
              data-section={item.id}
              aria-current={ariaCurrent}
            >
              <span class="sidebar__icon" aria-hidden="true">
                <Icon name={item.icon} size={20} />
              </span>
              <span class="sidebar__label">{item.label}</span>
            </a>
            {item.mobileHref && (
              <a
                class="sidebar__link show-on-mobile"
                href={item.mobileHref}
                data-section={item.id}
                aria-current={ariaCurrent}
              >
                <span class="sidebar__icon" aria-hidden="true">
                  <Icon name={item.icon} size={20} />
                </span>
                <span class="sidebar__label">{item.label}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
  <div class="sidebar__chip" aria-hidden="true">{versionLabel}</div>
</nav>

<script>
  // Scroll-spy: highlight the sidebar item whose section is closest to the
  // viewport center. Spec: interaction-spec.md §3.
  (function () {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".sidebar__link"),
    );
    if (links.length === 0) return;

    const sectionMap = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const id = link.dataset.section;
      if (id) sectionMap.set(id, link);
    }

    const targets: Element[] = [];
    for (const id of sectionMap.keys()) {
      const el = document.getElementById(id);
      if (el) targets.push(el);
    }
    if (targets.length === 0) return;

    let active: string | null = null;
    const setActive = (id: string) => {
      if (id === active) return;
      active = id;
      for (const link of links) {
        if (link.dataset.section === id) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    // When the user clicks a sidebar link, lock the highlight to that target
    // until the smooth-scroll settles — short sections near the bottom of
    // the page can never reach the activation line, so without this lock
    // the highlight would snap back to whichever earlier section sits above it.
    let lockedId: string | null = null;
    let unlockTimer: number | null = null;
    const unlockSoon = () => {
      if (unlockTimer !== null) window.clearTimeout(unlockTimer);
      unlockTimer = window.setTimeout(() => {
        lockedId = null;
        unlockTimer = null;
      }, 120);
    };

    // Scroll-spy: a section becomes active once its top crosses an
    // activation line ~15% from the viewport top. We pick the *last* section
    // in DOM order whose top is at or above that line, which collapses cleanly
    // to "home" at the top of the page and progresses through the sections
    // as the user scrolls down — and also handles scrolling back up, which
    // the previous IntersectionObserver couldn't (no event fires once every
    // section has left the central band).
    const computeActive = () => {
      if (lockedId) return;
      const line = window.innerHeight * 0.15;
      let nextId: string | null = null;
      for (const t of targets) {
        const rect = t.getBoundingClientRect();
        // Skip sections hidden on this viewport (display:none collapses the
        // bounding rect to 0×0, which would otherwise satisfy the line check
        // and steal the highlight from real content).
        if (rect.width === 0 && rect.height === 0) continue;
        if (rect.top <= line) {
          nextId = t.id;
        }
      }
      if (nextId) setActive(nextId);
    };

    let rafId: number | null = null;
    const schedule = () => {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(() => {
        rafId = null;
        computeActive();
      });
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    computeActive();

    for (const link of links) {
      link.addEventListener("click", () => {
        const id = link.dataset.section;
        if (!id) return;
        lockedId = id;
        setActive(id);
        // Hold the lock until scrolling stops; "scrollend" fires on modern
        // browsers, with a timeout fallback for Safari.
        const release = () => {
          window.removeEventListener("scrollend", release);
          unlockSoon();
        };
        window.addEventListener("scrollend", release, { once: true });
        window.setTimeout(release, 1000);
      });
    }
  })();
</script>

<style>
  .sidebar {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    width: var(--layout-sidebar-width);
    z-index: var(--z-sidebar);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    background: var(--color-surface-1);
    border: var(--border-width-strong) solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar__item {
    display: block;
  }

  .sidebar__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    margin-inline: calc(var(--space-1) * -1);
    padding: var(--space-2) var(--space-1);
    border-radius: var(--radius-md);
    color: var(--color-fg-muted);
    text-decoration: none;
    position: relative;
    transition: color var(--motion-quick) var(--ease-out-quart);
  }

  .sidebar__link:hover {
    color: var(--color-fg-default);
  }

  .sidebar__link[aria-current="location"] {
    color: var(--color-fg-on-accent);
    background: var(--color-accent);
  }

  .sidebar__link[aria-current="location"]:hover {
    color: var(--color-fg-on-accent);
  }

  .sidebar__icon {
    display: inline-flex;
  }

  .sidebar__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    letter-spacing: var(--tracking-wide);
    text-align: center;
    white-space: nowrap;
  }

  .sidebar__chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    letter-spacing: var(--tracking-wider);
    padding: var(--space-1) var(--space-2);
    border: var(--line-divider);
    border-radius: var(--radius-sm);
    margin-top: var(--space-2);
    text-align: center;
  }

  /*
   * Mobile: full-width floating bar; the page-header now flows below it
   * in document order rather than overlapping it.
   */
  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      top: var(--space-3);
      left: var(--space-3);
      right: var(--space-3);
      width: auto;
      flex-direction: row;
      align-items: center;
      padding: var(--space-2) var(--space-3);
      gap: var(--space-2);
    }
    .sidebar__list {
      flex-direction: row;
      flex: 1 1 auto;
      gap: var(--space-1);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .sidebar__list::-webkit-scrollbar {
      display: none;
    }
    /* Projects + Experience pivot to dedicated pages on mobile; push their
     * nav buttons to the right of the in-page anchor links. */
    .sidebar__item--mobile-tail {
      order: 1;
    }
    .sidebar__link {
      flex-direction: row;
      gap: var(--space-2);
      margin-inline: 0;
      padding: var(--space-2);
    }
    .sidebar__label {
      /* Visually hidden but still announced by screen readers. */
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .sidebar__chip {
      margin-top: 0;
      flex-shrink: 0;
    }
  }
</style>
