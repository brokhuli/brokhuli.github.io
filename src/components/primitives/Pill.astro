---
/*
 * Pill — small rounded tag.
 * Spec: references/specs/component-spec.md §4 Pill / TechPill
 *
 * `level` signals depth/usage independent of `tone`:
 *   - "working" (default): outlined chip — light to moderate use.
 *   - "core": filled accent chip — deep expertise / heavy use.
 */

interface Props {
  label?: string;
  tone?: "neutral" | "accent";
  level?: "working" | "core";
  class?: string;
}

const {
  label,
  tone = "neutral",
  level = "working",
  class: className = "",
} = Astro.props;
---

<span class:list={["pill", `pill--${tone}`, `pill--${level}`, className]}>
  {label ?? <slot />}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px var(--space-3);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    border: var(--border-width-thin) solid var(--color-border);
    background: var(--color-surface-2);
    color: var(--color-fg-muted);
    white-space: nowrap;
  }
  .pill--accent {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-muted);
  }

  /* Core level: filled accent chip — signals deep expertise / heavy use. */
  .pill--core {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-fg-on-accent);
    font-weight: var(--font-weight-medium);
  }
</style>
