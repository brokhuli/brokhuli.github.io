---
/*
 * TechPill — alias for Pill specialized for tech-tag usage.
 * Spec: references/specs/component-spec.md §4 Pill / TechPill
 */

import Pill from "./Pill.astro";

interface Props {
  label: string;
  tone?: "neutral" | "accent";
  level?: "working" | "core";
  class?: string;
}

const {
  label,
  tone = "neutral",
  level = "working",
  class: className = "",
} = Astro.props;
---

<Pill label={label} tone={tone} level={level} class={className} />
