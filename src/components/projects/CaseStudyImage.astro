---
/*
 * CaseStudyImage - plain image renderer for Markdown case-study bodies.
 *
 * Local Markdown image paths are resolved through Vite so the generated URL
 * remains valid from nested project routes. GIFs continue to bypass Sharp.
 */

interface Props {
  src: string;
  alt: string;
  maxWidth?: string;
}

const { src, alt, maxWidth = "100%" } = Astro.props;

const imageModules = import.meta.glob<string>(
  "/src/**/*.{avif,gif,jpeg,jpg,png,svg,webp}",
  {
    query: "?url",
    import: "default",
  },
);

const normaliseSuffix = (value: string) => value.replace(/^(?:\.\.\/)+/, "");
const suffix = normaliseSuffix(src);
const matchKey = Object.keys(imageModules).find((key) => key.endsWith(suffix));
const resolvedSrc = matchKey ? await imageModules[matchKey]() : src;
---

<img
  class="case-study-image"
  style={`width: min(100%, ${maxWidth}); max-width: ${maxWidth};`}
  src={resolvedSrc}
  alt={alt}
  loading="lazy"
  decoding="async"
/>

<style>
  .case-study-image {
    display: block;
    height: auto;
    margin-inline: 0 auto;
    border: var(--border-width-thin) solid var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
