---
import Card from "../primitives/Card.astro";
import SectionHeading from "../primitives/SectionHeading.astro";

interface Props {
  title: string;
  variant?: "default" | "accent";
}

const { title, variant = "default" } = Astro.props;
---

<Card class="case-study-section" variant={variant}>
  <SectionHeading slot="header" as="h2">{title}</SectionHeading>
  <div class="case-study-section__content">
    <slot />
  </div>
</Card>

<style>
  .case-study-section__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case-study-section__content :global(p) {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--text-base-line);
    color: var(--color-fg-body);
  }

  .case-study-section__content :global(h3) {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg-default);
    border-left: var(--border-width-strong) solid var(--color-accent);
    padding-left: var(--space-3);
  }

  .case-study-section__content :global(h4) {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .case-study-section__content :global(h5) {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
  }

  .case-study-section__content :global(ul),
  .case-study-section__content :global(ol) {
    margin: 0;
    padding-left: var(--space-6);
    color: var(--color-fg-body);
  }

  .case-study-section__content :global(ul) {
    list-style: disc;
  }

  .case-study-section__content :global(ol) {
    list-style: decimal;
  }

  .case-study-section__content :global(ul ul),
  .case-study-section__content :global(ol ol),
  .case-study-section__content :global(ul ol),
  .case-study-section__content :global(ol ul) {
    margin-top: var(--space-2);
  }

  .case-study-section__content :global(li) {
    padding-left: var(--space-1);
    line-height: var(--text-base-line);
  }

  .case-study-section__content :global(li + li) {
    margin-top: var(--space-2);
  }

  .case-study-section__content :global(li::marker) {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .case-study-section__content :global(a) {
    color: var(--color-accent);
  }

  .case-study-section__content :global(strong) {
    color: var(--color-fg-default);
    font-weight: var(--font-weight-semibold);
  }

  .case-study-section__content :global(em) {
    color: var(--color-fg-body);
    font-style: italic;
  }

  .case-study-section__content :global(del) {
    color: var(--color-fg-subtle);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--border-width-thin);
  }

  .case-study-section__content :global(blockquote) {
    margin: var(--space-1) 0;
    padding: var(--space-3) var(--space-4);
    color: var(--color-fg-body);
    background: var(--color-surface-2);
    border-left: var(--border-width-strong) solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .case-study-section__content :global(blockquote p) {
    color: inherit;
  }

  .case-study-section__content :global(hr) {
    width: 100%;
    height: var(--border-width-thin);
    margin: var(--space-3) 0;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border-strong),
      transparent
    );
    border: 0;
  }

  .case-study-section__content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: var(--color-fg-default);
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }

  .case-study-section__content :global(pre) {
    margin: var(--space-1) 0;
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    color: var(--color-fg-body);
    background: var(--color-surface-2);
    border: var(--border-width-thin) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .case-study-section__content :global(pre code) {
    display: block;
    padding: 0;
    color: inherit;
    background: transparent;
    border-radius: 0;
    white-space: pre;
  }

  .case-study-section__content :global(kbd) {
    display: inline-flex;
    align-items: center;
    min-width: 1.6em;
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 0.85em;
    line-height: 1.4;
    color: var(--color-fg-default);
    background: var(--color-surface-2);
    border: var(--border-width-thin) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 -1px 0 var(--color-border);
  }

  .case-study-section__content :global(img) {
    width: 100%;
    height: auto;
    border: var(--border-width-thin) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .case-study-section__content :global(figure) {
    margin: var(--space-1) 0;
  }

  .case-study-section__content :global(figcaption) {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    color: var(--color-fg-subtle);
  }

  .case-study-section__content :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    color: var(--color-fg-body);
  }

  .case-study-section__content :global(table code) {
    white-space: nowrap;
  }

  .case-study-section__content :global(th),
  .case-study-section__content :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--line-divider);
    text-align: left;
    vertical-align: top;
  }

  .case-study-section__content :global(th) {
    color: var(--color-fg-default);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    background: var(--color-surface-2);
  }

  .case-study-section__content :global(tbody tr:hover) {
    background: var(--color-surface-2);
  }

  .case-study-section__content :global(td:first-child),
  .case-study-section__content :global(th:first-child) {
    border-left: var(--border-width-thin) solid var(--color-border);
  }

  .case-study-section__content :global(td:last-child),
  .case-study-section__content :global(th:last-child) {
    border-right: var(--border-width-thin) solid var(--color-border);
  }

  .case-study-section__content :global(.contains-task-list) {
    padding-left: 0;
    list-style: none;
  }

  .case-study-section__content :global(.task-list-item) {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    padding-left: 0;
  }

  .case-study-section__content :global(.task-list-item input[type="checkbox"]) {
    appearance: none;
    display: grid;
    place-content: center;
    width: 14px;
    height: 14px;
    margin: 0.35em 0 0;
    background: var(--color-surface-1);
    border: var(--border-width-thin) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    flex: 0 0 auto;
  }

  .case-study-section__content
    :global(.task-list-item input[type="checkbox"]:checked::before) {
    content: "";
    width: 5px;
    height: 8px;
    border: solid var(--color-accent);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
  }
</style>
