---
/*
 * ContactCard — email (obfuscated), LinkedIn, GitHub.
 *
 * Email obfuscation contract (component-spec.md §2):
 *   Static HTML must never contain the full address or "mailto:sfullom".
 *   data-l / data-d split at "@"; assembled by the shared init script.
 *   Click also writes to clipboard; the icon row briefly shows "Copied!".
 */

import { Image } from "astro:assets";
import Card from "../primitives/Card.astro";
import SectionHeading from "../primitives/SectionHeading.astro";
import Icon from "../primitives/Icon.astro";
import headshot from "../../assets/img/about/head-shot.png";
import availabilityContent from "../../content/contact/content.md?raw";

const availabilityText = availabilityContent.trim();
---

<Card id="contact" variant="filled" class="card--mobile-plain">
  <SectionHeading slot="header" as="h2">Let's Connect</SectionHeading>

  <div class="contact__lockup">
    <Image
      src={headshot}
      alt="Stephen Ullom"
      width={96}
      height={96}
      format="png"
      densities={[1, 2, 3]}
      class="contact__headshot"
      loading="lazy"
    />

    <div class="contact__body">
      {
        availabilityText && (
          <p class="contact__availability">{availabilityText}</p>
        )
      }

      <ul class="contact__list" role="list">
        <li class="contact__row">
          <a
            class="contact__link"
            href="#"
            data-email-obfuscate
            data-l="sfullom"
            data-d="gmail.com"
            aria-label="Send email"
          >
            <span class="contact__icon">
              <Icon name="lucide:mail" size={18} />
            </span>
            <span class="contact__label">Email</span>
            <span class="contact__value" data-email-text>Email</span>
          </a>
        </li>
        <li class="contact__row">
          <a
            class="contact__link"
            href="https://linkedin.com/in/stephen-ullom-7014a455"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact__icon">
              <Icon name="lucide:linkedin" size={18} />
            </span>
            <span class="contact__label">LinkedIn</span>
            <span class="contact__value"
              >linkedin.com/in/stephen-ullom-7014a455</span
            >
          </a>
        </li>
        <li class="contact__row">
          <a
            class="contact__link"
            href="https://github.com/brokhuli"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact__icon">
              <Icon name="lucide:github" size={18} />
            </span>
            <span class="contact__label">GitHub</span>
            <span class="contact__value">github.com/brokhuli</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</Card>

<script>
  import { initEmailObfuscation } from "../../scripts/email-obfuscate";
  initEmailObfuscation();
</script>

<style>
  .contact__lockup {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .contact__headshot {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-pill);
    flex-shrink: 0;
    object-fit: cover;
    background: var(--color-surface-1);
    border: var(--line-divider);
  }

  .contact__body {
    flex: 1;
    min-width: 0;
  }

  .contact__availability {
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 var(--space-5);
    font-style: italic;
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
  }

  .contact__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact__row {
    display: flex;
  }

  .contact__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-fg-default);
    padding: var(--space-2);
    margin: calc(var(--space-2) * -1);
    border-radius: var(--radius-sm);
    transition: color var(--motion-quick) var(--ease-out-quart);
    width: 100%;
  }

  .contact__link:hover {
    color: var(--color-accent);
  }

  .contact__icon {
    display: inline-flex;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    letter-spacing: var(--tracking-wide);
    width: 64px;
    flex-shrink: 0;
  }

  .contact__value {
    font-size: var(--text-sm);
    color: var(--color-fg-default);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  @media (max-width: 520px) {
    .contact__lockup {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .contact__availability {
      text-align: left;
    }
  }

  /* Mobile: collapse to DomainsCard-style icon+label grid. Headshot,
   * availability copy, and URL values are hidden so each row reads as a
   * compact icon + label pair. The whole row stays clickable. */
  @media (max-width: 640px) {
    .contact__headshot,
    .contact__availability,
    .contact__value {
      display: none;
    }
    .contact__lockup {
      gap: 0;
    }
    .contact__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
    .contact__link {
      gap: var(--space-2);
      padding: 0;
      margin: 0;
    }
    .contact__label {
      font-family: inherit;
      font-size: var(--text-sm);
      line-height: var(--text-sm-line);
      color: var(--color-fg-default);
      letter-spacing: normal;
      width: auto;
    }
  }
</style>
