---
/*
 * ContactCard — email (obfuscated), LinkedIn, GitHub.
 *
 * Email obfuscation contract (component-spec.md §2):
 *   Static HTML must never contain the full address or "mailto:sfullom".
 *   data-l / data-d split at "@"; assembled by the shared init script.
 *   Click also writes to clipboard; the icon row briefly shows "Copied!".
 */

import { Image } from "astro:assets";
import Card from "../primitives/Card.astro";
import SectionHeading from "../primitives/SectionHeading.astro";
import Icon from "../primitives/Icon.astro";
import headshot from "../../assets/img/head-shot-03.png";
import medicalDeviceSvg from "../../assets/img/sketches/medical-device.svg?raw";
---

<Card id="contact">
  <SectionHeading slot="header" as="h2">Contact</SectionHeading>

  <div class="contact__lockup">
    <Image
      src={headshot}
      alt="Stephen Ullom"
      width={96}
      height={96}
      class="contact__headshot"
      loading="lazy"
    />

    <div class="contact__body">
      <p class="contact__availability">
        Open to Principal / Staff / Architect roles in simulation, digital
        engineering, transportation, energy, robotics, industrial automation, or
        medtech.
      </p>

      <ul class="contact__list" role="list">
        <li class="contact__row">
          <a
            class="contact__link"
            href="#"
            data-email-obfuscate
            data-l="sfullom"
            data-d="gmail.com"
            aria-label="Send email"
          >
            <span class="contact__icon">
              <Icon name="lucide:mail" size={18} />
            </span>
            <span class="contact__label">Email</span>
            <span class="contact__value" data-email-text>Email</span>
          </a>
        </li>
        <li class="contact__row">
          <a
            class="contact__link"
            href="https://linkedin.com/in/stephen-ullom-7014a455"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact__icon">
              <Icon name="lucide:linkedin" size={18} />
            </span>
            <span class="contact__label">LinkedIn</span>
            <span class="contact__value"
              >linkedin.com/in/stephen-ullom-7014a455</span
            >
          </a>
        </li>
        <li class="contact__row">
          <a
            class="contact__link"
            href="https://github.com/brokhuli"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact__icon">
              <Icon name="lucide:github" size={18} />
            </span>
            <span class="contact__label">GitHub</span>
            <span class="contact__value">github.com/brokhuli</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="contact__sketch" aria-hidden="true" set:html={medicalDeviceSvg} />
</Card>

<script>
  import { initEmailObfuscation } from "../../scripts/email-obfuscate";
  initEmailObfuscation();
</script>

<style>
  .contact__lockup {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .contact__headshot {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-pill);
    flex-shrink: 0;
    object-fit: cover;
    border: var(--line-divider);
  }

  .contact__body {
    flex: 1;
    min-width: 0;
  }

  .contact__availability {
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-5);
    font-style: italic;
  }

  .contact__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact__row {
    display: flex;
  }

  .contact__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-fg-default);
    padding: var(--space-2);
    margin: calc(var(--space-2) * -1);
    border-radius: var(--radius-sm);
    transition: color var(--motion-quick) var(--ease-out-quart);
    width: 100%;
  }

  .contact__link:hover {
    color: var(--color-accent);
  }

  .contact__icon {
    display: inline-flex;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    letter-spacing: var(--tracking-wide);
    width: 64px;
    flex-shrink: 0;
  }

  .contact__value {
    font-size: var(--text-sm);
    color: var(--color-fg-default);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .contact__sketch {
    margin-top: var(--space-4);
    display: flex;
    justify-content: flex-end;
    color: var(--color-fg-subtle);
    opacity: 0.65;
  }

  .contact__sketch :global(svg) {
    width: 100%;
    max-width: 200px;
    height: auto;
  }

  @media (max-width: 640px) {
    .contact__sketch {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .contact__lockup {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .contact__availability {
      text-align: left;
    }
  }
</style>
