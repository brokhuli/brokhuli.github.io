---
/*
 * EducationEntry - single school row inside the Education card on /resume.
 * Modeled on ExperienceEntry; visual rhythm intentionally matches.
 */

import type { CollectionEntry } from "astro:content";
import Icon from "../primitives/Icon.astro";

interface Props {
  entry: CollectionEntry<"education">;
}

const { entry } = Astro.props;
const { institution, degree, field, years, honors, institutionIcon } =
  entry.data;
const yearStr = years.end
  ? `${years.start} - ${years.end}`
  : `${years.start} - Present`;
const credential = field ? `${degree} | ${field}` : degree;
---

<article class="edu-entry">
  <div class="edu-entry__header">
    <div class="edu-entry__left">
      {
        institutionIcon && (
          <span class="edu-entry__icon" aria-hidden="true">
            <Icon name={institutionIcon} size={16} />
          </span>
        )
      }
      <div class="edu-entry__titles">
        <span class="edu-entry__degree">{credential}</span>
        <span class="edu-entry__institution">{institution}</span>
        {honors && <span class="edu-entry__honors">{honors}</span>}
      </div>
    </div>
    <span class="edu-entry__years">{yearStr}</span>
  </div>
</article>

<style>
  .edu-entry {
    padding-bottom: var(--space-5);
    border-bottom: var(--line-divider);
  }

  .edu-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .edu-entry__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .edu-entry__left {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .edu-entry__icon {
    display: inline-flex;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .edu-entry__titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .edu-entry__degree {
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    color: var(--color-fg-default);
    line-height: 1.3;
  }

  .edu-entry__institution {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .edu-entry__honors {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .edu-entry__years {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
