---
/*
 * EducationEntry — single school row inside the Education card on /resume.
 * Modeled on ExperienceEntry; visual rhythm intentionally matches.
 */

import type { CollectionEntry } from "astro:content";
import Icon from "../primitives/Icon.astro";
import Pill from "../primitives/Pill.astro";

interface Props {
  entry: CollectionEntry<"education">;
}

const { entry } = Astro.props;
const {
  institution,
  degree,
  field,
  years,
  highlights,
  institutionIcon,
  summary,
} = entry.data;
const yearStr = years.end
  ? `${years.start} – ${years.end}`
  : `${years.start} – Present`;
const credential = field ? `${degree}, ${field}` : degree;
---

<article class="edu-entry">
  <div class="edu-entry__header">
    <div class="edu-entry__left">
      {
        institutionIcon && (
          <span class="edu-entry__icon" aria-hidden="true">
            <Icon name={institutionIcon} size={16} />
          </span>
        )
      }
      <div class="edu-entry__titles">
        <span class="edu-entry__degree">{credential}</span>
        <span class="edu-entry__institution">{institution}</span>
      </div>
    </div>
    <span class="edu-entry__years">{yearStr}</span>
  </div>
  {summary && <p class="edu-entry__summary">{summary}</p>}
  {
    highlights && highlights.length > 0 && (
      <ul class="edu-entry__highlights" role="list" aria-label="Highlights">
        {highlights.map((h) => (
          <li>
            <Pill label={h} tone="neutral" />
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .edu-entry {
    padding-bottom: var(--space-5);
    border-bottom: var(--line-divider);
  }

  .edu-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .edu-entry__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .edu-entry__left {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .edu-entry__icon {
    display: inline-flex;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .edu-entry__titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .edu-entry__degree {
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    color: var(--color-fg-default);
    line-height: 1.3;
  }

  .edu-entry__institution {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .edu-entry__years {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .edu-entry__summary {
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-3);
  }

  .edu-entry__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
