---
/*
 * ProjectsSection — grid of featured ProjectCards.
 * Reads only featured projects; pages do NOT prop-drill data (ADR-004).
 * Spec: references/specs/component-spec.md §2 ProjectsSection
 */

import { getCollection } from "astro:content";
import SectionHeading from "../primitives/SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";

const projects = (await getCollection("projects", (e) => e.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="projects" class="projects-section">
  <div class="projects-section__header">
    <SectionHeading as="h2">Featured Projects</SectionHeading>
    <a class="projects-section__all-link" href="/projects/">
      View All Projects →
    </a>
  </div>
  <div class="projects-section__grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</section>

<style>
  .projects-section {
    margin-bottom: var(--space-16);
  }

  .projects-section__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .projects-section__all-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    color: var(--color-accent);
    text-decoration: none;
    padding-top: var(--space-1);
    white-space: nowrap;
  }

  .projects-section__all-link:hover {
    color: var(--color-accent-hover);
  }

  .projects-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .projects-section__header {
      flex-direction: column;
      gap: var(--space-2);
    }

    .projects-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
