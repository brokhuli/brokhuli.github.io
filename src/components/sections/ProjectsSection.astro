---
/*
 * ProjectsSection — grid of featured ProjectCards.
 * Reads only featured projects; pages do NOT prop-drill data (ADR-004).
 * Spec: references/specs/component-spec.md §2 ProjectsSection
 */

import { getCollection } from "astro:content";
import SectionHeading from "../primitives/SectionHeading.astro";
import Icon from "../primitives/Icon.astro";
import ProjectCard from "./ProjectCard.astro";

const projects = (await getCollection("projects", (e) => e.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="projects" class="projects-section">
  <div class="projects-section__header">
    <SectionHeading as="h2">Featured Projects</SectionHeading>
    <a class="projects-section__all-link" href="/projects/">
      View All Projects →
    </a>
  </div>
  <div class="projects-section__grid">
    {projects.map((p) => <ProjectCard project={p} />)}
    <article class="projects-section__coming-soon">
      <span class="projects-section__coming-icon" aria-hidden="true">
        <Icon name="lucide:plus" size={18} />
      </span>
      <h3 class="projects-section__coming-title">
        More case studies in progress
      </h3>
      <p class="projects-section__coming-copy">
        More project writeups and technical deep-dives are currently in
        development.
      </p>
    </article>
  </div>
</section>

<style>
  .projects-section {
    margin-bottom: var(--space-16);
  }

  .projects-section__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .projects-section__all-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    color: var(--color-accent);
    text-decoration: none;
    padding-top: var(--space-1);
    white-space: nowrap;
  }

  .projects-section__all-link:hover {
    color: var(--color-accent-hover);
  }

  .projects-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .projects-section__coming-soon {
    min-height: 220px;
    background: var(--color-surface-1);
    border: var(--line-card);
    border-style: dashed;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    color: var(--color-fg-muted);
  }

  .projects-section__coming-icon {
    display: inline-flex;
    color: var(--color-accent);
  }

  .projects-section__coming-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--text-lg-line);
    font-weight: var(--font-weight-semibold);
    color: var(--color-fg-default);
    margin: 0;
  }

  .projects-section__coming-copy {
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: var(--text-sm-line);
    margin: 0;
    color: var(--color-fg-body);
  }

  @media (max-width: 640px) {
    .projects-section__header {
      flex-direction: column;
      gap: var(--space-2);
    }

    .projects-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
