---
/*
 * TechStackCard — tech items grouped by capability bucket.
 * Spec: references/specs/component-spec.md §2 TechStackCard
 */

import { getCollection } from "astro:content";
import Card from "../primitives/Card.astro";
import SectionHeading from "../primitives/SectionHeading.astro";
import TechPill from "../primitives/TechPill.astro";

const items = await getCollection("techStack");

const groupMeta: Record<string, { label: string; order: number }> = {
  languages: { label: "Languages", order: 1 },
  frameworks: { label: "Frameworks", order: 2 },
  "ai-native-engineering": { label: "AI-Native Engineering", order: 3 },
  "data-engineering": { label: "Data Engineering", order: 4 },
  "distributed-systems": { label: "Distributed Systems", order: 5 },
  "observability-cicd": { label: "Observability & CI/CD", order: 6 },
  architectures: { label: "Architectures", order: 7 },
};

const highlightedTech = new Set([
  "C#",
  ".Net",
  "React",
  "REST",
  "PostgreSQL",
  "Claude Code",
  "Docker",
  "Modular Monolith",
  "Service-Oriented",
  "Event-Driven",
]);

const groups = Object.entries(groupMeta)
  .sort(([, a], [, b]) => a.order - b.order)
  .map(([key, meta]) => ({
    key,
    label: meta.label,
    items: items
      .filter((i) => i.data.group === key)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((g) => g.items.length > 0);
---

<Card id="tech-stack">
  <SectionHeading slot="header" as="h2">Tech Stack</SectionHeading>
  <div class="tech-stack__groups">
    {
      groups.map((g) => (
        <div class="tech-stack__group">
          <h3 class="tech-stack__group-label">{g.label}</h3>
          <ul class="tech-stack__pills" role="list">
            {g.items.map((i) => (
              <li>
                <TechPill
                  label={i.data.label}
                  level={highlightedTech.has(i.data.label) ? "core" : "working"}
                />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Card>

<style>
  .tech-stack__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .tech-stack__group-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin: 0 0 var(--space-2);
  }

  .tech-stack__pills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
