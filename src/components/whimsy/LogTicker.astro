---
/*
 * LogTicker — quiet 3-line stack at the bottom of the viewport, framed in
 * a subtle trapezoid.
 *
 * Specs:
 *   references/specs/component-spec.md §5 LogTicker
 *   references/specs/interaction-spec.md §9
 *   references/specs/whimsical-elements.md (idea 5)
 *
 * Lines are read from the `logLines` collection at build time and embedded
 * into a JSON script so the runtime needs no network. The cycler picks from
 * a calm pool (INFO|SYS|DBG) by default and surfaces a rare WARN/ERR (~5%).
 */

import { getCollection } from "astro:content";

const entries = await getCollection("logLines");
const allLines = entries.flatMap((e) => e.data.lines);
const calm = allLines.filter(
  (l) => l.level === "INFO" || l.level === "SYS" || l.level === "DBG",
);
const alert = allLines.filter((l) => l.level === "WARN" || l.level === "ERR");

// Pre-render 3 static lines so SSR + <noscript> visitors see something.
const initial = calm.slice(0, 3);
while (initial.length < 3 && calm.length > 0) initial.push(calm[0]);

// Build-time timestamps; the client script refreshes them on hydration.
const pad = (n: number) => String(n).padStart(2, "0");
const fmtTime = (d: Date) =>
  `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
const buildNow = new Date();
const initialTimes = [
  fmtTime(new Date(buildNow.getTime() - 4000)),
  fmtTime(new Date(buildNow.getTime() - 2000)),
  fmtTime(buildNow),
];

const dataId = "log-ticker-data";
---

<div class="log-ticker" data-log-ticker aria-hidden="true">
  <div class="log-ticker__frame">
    <div class="log-ticker__stack" data-log-ticker-stack>
      {
        initial.map((l, i) => (
          <span class="log-ticker__line" data-log-ticker-line>
            <span class="log-ticker__time" data-log-ticker-time>
              [{initialTimes[i]}]
            </span>
            <span class="log-ticker__level" data-level={l.level}>
              [{l.level}]
            </span>
            <span class="log-ticker__text" data-log-ticker-text>
              {l.text}
            </span>
          </span>
        ))
      }
    </div>
  </div>
</div>

<script
  is:inline
  id={dataId}
  type="application/json"
  set:html={JSON.stringify({ calm, alert })}
/>

<script>
  // 3-line stack cycler. Spec: interaction-spec.md §9.
  //   - oldest line fades out at the top (800ms)
  //   - middle two slide up
  //   - new line fades in at the bottom (800ms)
  //   - 70% realistic / 30% absurd; never repeat the previous
  //   - pause when tab is hidden or pointer hovers
  //   - reduced-motion: render three static lines and stop
  (function () {
    type Line = {
      level: "INFO" | "SYS" | "DBG" | "WARN" | "ERR";
      text: string;
      tone: "realistic" | "absurd";
    };
    type Payload = { calm: Line[]; alert: Line[] };

    const ticker = document.querySelector<HTMLElement>("[data-log-ticker]");
    const stack = document.querySelector<HTMLElement>(
      "[data-log-ticker-stack]",
    );
    const dataNode = document.getElementById("log-ticker-data");
    if (!ticker || !stack || !dataNode) return;

    let calm: Line[] = [];
    let alert: Line[] = [];
    try {
      const parsed = JSON.parse(dataNode.textContent || "{}") as Payload;
      calm = parsed.calm || [];
      alert = parsed.alert || [];
    } catch {
      return;
    }
    if (calm.length === 0) return;

    const realistic = calm.filter((l) => l.tone === "realistic");
    const absurd = calm.filter((l) => l.tone === "absurd");

    const ALERT_RATE = 0.05;

    let prev: Line | null = null;
    const pick = (): Line => {
      // Rare-ish WARN/ERR drop-in.
      if (alert.length > 0 && Math.random() < ALERT_RATE) {
        let next = alert[Math.floor(Math.random() * alert.length)];
        if (prev && alert.length > 1 && next.text === prev.text) {
          next = alert[(alert.indexOf(next) + 1) % alert.length];
        }
        prev = next;
        return next;
      }
      const useAbsurd = absurd.length > 0 && Math.random() < 0.3;
      const pool = useAbsurd ? absurd : realistic.length ? realistic : calm;
      let next = pool[Math.floor(Math.random() * pool.length)];
      if (prev && pool.length > 1 && next.text === prev.text) {
        next = pool[(pool.indexOf(next) + 1) % pool.length];
      }
      prev = next;
      return next;
    };

    const pad2 = (n: number) => String(n).padStart(2, "0");
    const nowStamp = (): string => {
      const d = new Date();
      return `[${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}]`;
    };

    const buildLine = (l: Line): HTMLElement => {
      const span = document.createElement("span");
      span.className = "log-ticker__line";
      span.setAttribute("data-log-ticker-line", "");
      const time = document.createElement("span");
      time.className = "log-ticker__time";
      time.setAttribute("data-log-ticker-time", "");
      time.textContent = nowStamp();
      const level = document.createElement("span");
      level.className = "log-ticker__level";
      level.dataset.level = l.level;
      level.textContent = `[${l.level}]`;
      const text = document.createElement("span");
      text.className = "log-ticker__text";
      text.setAttribute("data-log-ticker-text", "");
      text.textContent = l.text;
      span.appendChild(time);
      span.appendChild(level);
      span.appendChild(text);
      return span;
    };

    const reduced =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      // Replace SSR with three fresh static lines, no cycling.
      stack.innerHTML = "";
      for (let i = 0; i < 3; i++) {
        const el = buildLine(pick());
        el.style.opacity = "0.7";
        stack.appendChild(el);
      }
      return;
    }

    // Reuse the SSR-rendered slot elements; only their text content cycles.
    // Keeping the same DOM nodes avoids the layout shift that an
    // innerHTML wipe-and-rebuild would cause inside the fixed-width frame.
    const existing = Array.from(
      stack.querySelectorAll<HTMLElement>(".log-ticker__line"),
    );
    while (existing.length < 3) {
      const fresh = buildLine(pick());
      stack.appendChild(fresh);
      existing.push(fresh);
    }
    const slots = existing.slice(0, 3);
    for (const slot of slots) slot.style.opacity = "1";

    // Refresh the SSR-baked timestamps on hydration so visitors see "now"
    // instead of the build-time clock. Stagger by a couple of seconds so the
    // existing lines read like a recent run rather than three identical ticks.
    const refreshSeed = new Date();
    slots.forEach((slot, idx) => {
      const time = slot.querySelector<HTMLElement>(".log-ticker__time");
      if (!time) return;
      const stamp = new Date(refreshSeed.getTime() - (2 - idx) * 2000);
      time.textContent = `[${pad2(stamp.getHours())}:${pad2(stamp.getMinutes())}:${pad2(stamp.getSeconds())}]`;
    });

    let paused = false;

    const FADE = 600;
    const TICK_MIN = 2000;
    const TICK_MAX = 6000;
    const nextTick = () => TICK_MIN + Math.random() * (TICK_MAX - TICK_MIN);

    const setSlotText = (slot: HTMLElement, line: Line) => {
      const time = slot.querySelector<HTMLElement>(".log-ticker__time");
      const level = slot.querySelector<HTMLElement>(".log-ticker__level");
      const text = slot.querySelector<HTMLElement>(".log-ticker__text");
      if (time) time.textContent = nowStamp();
      if (level) {
        level.dataset.level = line.level;
        level.textContent = `[${line.level}]`;
      }
      if (text) text.textContent = line.text;
    };

    const rotate = () => {
      // Shift content up: slot[0] takes slot[1], slot[1] takes slot[2],
      // slot[2] gets a freshly picked line with a brief fade-in.
      const next0 = slots[1].cloneNode(true) as HTMLElement;
      const next1 = slots[2].cloneNode(true) as HTMLElement;
      const fresh = pick();

      const lvl0 = next0.querySelector<HTMLElement>(".log-ticker__level");
      const txt0 = next0.querySelector<HTMLElement>(".log-ticker__text");
      const lvl1 = next1.querySelector<HTMLElement>(".log-ticker__level");
      const txt1 = next1.querySelector<HTMLElement>(".log-ticker__text");

      const tm0 = next0.querySelector<HTMLElement>(".log-ticker__time");
      const tm1 = next1.querySelector<HTMLElement>(".log-ticker__time");

      // Apply text directly to the live slots (no DOM swap).
      if (lvl0 && txt0) {
        const tmA = slots[0].querySelector<HTMLElement>(".log-ticker__time");
        const lvlA = slots[0].querySelector<HTMLElement>(".log-ticker__level");
        const txtA = slots[0].querySelector<HTMLElement>(".log-ticker__text");
        if (tmA && tm0) tmA.textContent = tm0.textContent;
        if (lvlA) {
          lvlA.dataset.level = lvl0.dataset.level || "INFO";
          lvlA.textContent = lvl0.textContent;
        }
        if (txtA) txtA.textContent = txt0.textContent;
      }
      if (lvl1 && txt1) {
        const tmB = slots[1].querySelector<HTMLElement>(".log-ticker__time");
        const lvlB = slots[1].querySelector<HTMLElement>(".log-ticker__level");
        const txtB = slots[1].querySelector<HTMLElement>(".log-ticker__text");
        if (tmB && tm1) tmB.textContent = tm1.textContent;
        if (lvlB) {
          lvlB.dataset.level = lvl1.dataset.level || "INFO";
          lvlB.textContent = lvl1.textContent;
        }
        if (txtB) txtB.textContent = txt1.textContent;
      }

      const tail = slots[2];
      tail.style.transition = `opacity ${FADE}ms linear`;
      tail.style.opacity = "0";
      window.setTimeout(() => {
        setSlotText(tail, fresh);
        requestAnimationFrame(() => {
          tail.style.opacity = "1";
        });
      }, FADE / 2);
    };

    const cycle = () => {
      if (!paused) rotate();
      window.setTimeout(cycle, nextTick());
    };

    document.addEventListener("visibilitychange", () => {
      paused = document.visibilityState === "hidden";
    });

    let resumeTimer: number | null = null;
    ticker.addEventListener("pointerenter", () => {
      paused = true;
      if (resumeTimer !== null) clearTimeout(resumeTimer);
    });
    ticker.addEventListener("pointerleave", () => {
      if (resumeTimer !== null) clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => (paused = false), 500);
    });

    type IdleWin = Window & {
      requestIdleCallback?: (
        cb: () => void,
        opts?: { timeout: number },
      ) => void;
    };
    const w = window as IdleWin;
    const start = () => {
      window.setTimeout(cycle, nextTick());
    };
    if (typeof w.requestIdleCallback === "function") {
      w.requestIdleCallback(start, { timeout: 1500 });
    } else {
      setTimeout(start, 200);
    }
  })();
</script>

<style>
  .log-ticker {
    position: fixed;
    bottom: var(--space-3);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-overlay);
    pointer-events: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    color: var(--color-fg-muted);
    opacity: var(--log-ticker-opacity);
    /* Fixed width keeps the centered frame from shifting when line text
     * changes (CLS-safe). */
    width: min(90vw, 520px);
  }

  .log-ticker__frame {
    background: var(--color-surface-1);
    border: var(--border-width-strong) solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: var(--space-2) var(--space-5);
  }

  .log-ticker__stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .log-ticker__line {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    white-space: nowrap;
    overflow: hidden;
    min-width: 0;
  }

  .log-ticker__text {
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }

  .log-ticker__time {
    color: var(--color-fg-subtle);
    flex-shrink: 0;
  }

  .log-ticker__level {
    font-weight: var(--font-weight-medium);
    color: var(--color-info);
    flex-shrink: 0;
  }
  .log-ticker__level[data-level="INFO"] {
    color: var(--color-info);
  }
  .log-ticker__level[data-level="SYS"] {
    color: var(--color-success);
  }
  .log-ticker__level[data-level="DBG"] {
    color: var(--color-debug);
  }
  .log-ticker__level[data-level="WARN"] {
    color: var(--color-warning);
  }
  .log-ticker__level[data-level="ERR"] {
    color: var(--color-danger);
  }

  /* Mobile: hide to avoid covering content */
  @media (max-width: 640px) {
    .log-ticker {
      display: none;
    }
  }
</style>
