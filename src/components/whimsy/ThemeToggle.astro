---
/*
 * ThemeToggle - segmented control for the site's finite theme set.
 *
 * Specs:
 *   references/specs/component-spec.md section 5 ThemeToggle
 *   references/specs/interaction-spec.md section 7
 *
 * Initial theme is set synchronously by the inline <script is:inline> in
 * BaseLayout; this component only handles user clicks and persistence.
 */

import Icon from "../primitives/Icon.astro";

const themes = [
  {
    value: "dark",
    label: "Dark",
    icon: "lucide:moon",
    tip: "For late-night systems thinking",
  },
  {
    value: "theme-3",
    label: "Ultraviolet",
    icon: "lucide:moon-star",
    tip: "Ultraviolet Night: dark aubergine with dark mint signal",
  },
  {
    value: "theme-5",
    label: "Rose",
    icon: "lucide:flower-2",
    tip: "Rose: deep ink surfaces with raspberry accents",
  },
  {
    value: "theme-8",
    label: "Copper",
    icon: "lucide:cable",
    tip: "Copperline: dark navy with copper signal",
  },
  {
    value: "light",
    label: "Eric",
    icon: "lucide:sun",
    tip: "For daylight clarity, but mostly for Eric",
  },
];
---

<fieldset class="theme-toggle" data-theme-toggle>
  <legend class="sr-only">Theme</legend>

  {
    themes.map((theme) => (
      <label class="theme-toggle__option">
        <input
          type="radio"
          name="theme"
          value={theme.value}
          class="theme-toggle__input"
          aria-label={`${theme.label} theme`}
          title={theme.tip}
        />
        <span class="theme-toggle__chip">
          <Icon name={theme.icon} size={14} />
          <span class="theme-toggle__label">{theme.label}</span>
        </span>
      </label>
    ))
  }
</fieldset>

<script>
  // Theme toggle behavior. The initial theme is set by the inline
  // theme-init script in BaseLayout; this script only:
  //   1. syncs the radio's checked state from data-theme on mount, and
  //   2. writes data-theme + localStorage.theme on user change.
  // Spec: interaction-spec.md section 7.
  (function () {
    const themes = ["dark", "theme-3", "theme-5", "theme-8", "light"];
    const root = document.documentElement;
    const fieldsets = document.querySelectorAll<HTMLFieldSetElement>(
      "[data-theme-toggle]",
    );
    if (fieldsets.length === 0) return;

    const sync = (theme: string) => {
      for (const fs of fieldsets) {
        const inputs = fs.querySelectorAll<HTMLInputElement>(
          ".theme-toggle__input",
        );
        for (const input of inputs) input.checked = input.value === theme;
      }
    };

    const current = themes.includes(root.dataset.theme || "")
      ? root.dataset.theme || "dark"
      : "dark";
    sync(current);

    for (const fs of fieldsets) {
      fs.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement | null;
        if (!target || target.name !== "theme") return;
        const next = themes.includes(target.value) ? target.value : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage unavailable (Safari private mode, etc.) - DOM update is enough.
        }
        sync(next);
      });
    }

    // `t` keyboard shortcut cycles the theme list.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "t" || e.metaKey || e.ctrlKey || e.altKey) return;
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      const currentIndex = themes.indexOf(root.dataset.theme || "");
      const next = themes[(currentIndex + 1) % themes.length] || "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // ignore
      }
      sync(next);
    });
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theme-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    margin: 0;
    border: var(--border-width-strong) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
    max-width: min(100%, calc(100vw - var(--space-6)));
    justify-content: flex-end;
  }

  .theme-toggle__option {
    position: relative;
    display: inline-flex;
  }

  .theme-toggle__input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .theme-toggle__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: calc(var(--radius-md) - 2px);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    letter-spacing: var(--tracking-wide);
    transition:
      background-color var(--motion-base) var(--ease-in-out-quad),
      color var(--motion-base) var(--ease-in-out-quad);
  }

  .theme-toggle__input:checked + .theme-toggle__chip {
    background: var(--color-accent);
    color: var(--color-fg-on-accent);
  }

  .theme-toggle__input:focus-visible + .theme-toggle__chip {
    outline: var(--border-width-strong) solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__chip {
      transition-duration: var(--motion-instant);
    }
  }

  @media (max-width: 480px) {
    .theme-toggle {
      justify-content: flex-end;
    }

    .theme-toggle__chip {
      padding-inline: var(--space-2);
    }
  }
</style>
