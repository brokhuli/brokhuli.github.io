---
/*
 * ThemeToggle - segmented control for the site's finite theme set.
 *
 * Specs:
 *   references/specs/component-spec.md section 5 ThemeToggle
 *   references/specs/interaction-spec.md section 7
 *
 * Initial theme is set synchronously by the inline script (is:inline) in
 * BaseLayout; this component only handles user clicks and persistence.
 */

import Icon from "../primitives/Icon.astro";

/*
 * Mode toggle: picks dark vs. "Eric" (light) within the active palette pair.
 * The pair itself is chosen by ThemePairSelector in the footer.
 */
const themes = [
  {
    value: "dark",
    label: "Dark",
    icon: "lucide:moon",
    showLabel: true,
    tip: "For late-night systems thinking",
  },
  {
    value: "eric",
    label: "Eric",
    icon: "lucide:sun",
    showLabel: true,
    tip: "For daylight clarity, but mostly for Eric",
  },
];
---

<fieldset class="theme-toggle" data-theme-toggle>
  <legend class="sr-only">Theme</legend>

  {
    themes.map((theme) => (
      <label class="theme-toggle__option">
        <input
          type="radio"
          name="theme"
          value={theme.value}
          class="theme-toggle__input"
          aria-label={`${theme.label} theme`}
          title={theme.tip}
        />
        <span
          class:list={[
            "theme-toggle__chip",
            !theme.showLabel && "theme-toggle__chip--icon-only",
          ]}
        >
          <Icon name={theme.icon} size={14} />
          {theme.showLabel && (
            <span class="theme-toggle__label">{theme.label}</span>
          )}
        </span>
      </label>
    ))
  }
</fieldset>

<script>
  // Mode toggle (dark / Eric). The initial theme is set by the inline
  // theme-init script in BaseLayout; this script only:
  //   1. syncs the radio's checked state from data-theme on mount + on the
  //      `themechange` event (fired when the pair selector changes things),
  //   2. resolves mode + active pair into a theme value on user change.
  // The `t` keyboard shortcut lives in ThemePairSelector.
  // Spec: interaction-spec.md section 7.
  import { describeTheme, applyTheme } from "../../scripts/themes";

  (function () {
    const root = document.documentElement;
    const fieldsets = document.querySelectorAll<HTMLFieldSetElement>(
      "[data-theme-toggle]",
    );
    if (fieldsets.length === 0) return;

    const sync = () => {
      const { mode } = describeTheme(root.dataset.theme);
      for (const fs of fieldsets) {
        const inputs = fs.querySelectorAll<HTMLInputElement>(
          ".theme-toggle__input",
        );
        for (const input of inputs) input.checked = input.value === mode;
      }
    };

    sync();

    for (const fs of fieldsets) {
      fs.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement | null;
        if (!target || target.name !== "theme") return;
        const { pair } = describeTheme(root.dataset.theme);
        applyTheme(target.value === "eric" ? pair.eric : pair.dark);
      });
    }

    document.addEventListener("themechange", sync);
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theme-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    margin: 0;
    border: var(--border-width-strong) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
    max-width: min(100%, calc(100vw - var(--space-6)));
    justify-content: flex-end;
  }

  .theme-toggle__option {
    position: relative;
    display: inline-flex;
  }

  .theme-toggle__input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .theme-toggle__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    border-radius: calc(var(--radius-md) - 2px);
    color: var(--color-fg-ui);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    letter-spacing: var(--tracking-wide);
    transition:
      background-color var(--motion-base) var(--ease-in-out-quad),
      color var(--motion-base) var(--ease-in-out-quad);
  }

  .theme-toggle__chip--icon-only {
    justify-content: center;
    width: 28px;
  }

  .theme-toggle__input:checked + .theme-toggle__chip {
    background: var(--color-accent-fill);
    color: var(--color-fg-on-accent);
  }

  .theme-toggle__input:focus-visible + .theme-toggle__chip {
    outline: var(--border-width-strong) solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__chip {
      transition-duration: var(--motion-instant);
    }
  }

  @media (max-width: 480px) {
    .theme-toggle {
      justify-content: flex-end;
    }

    .theme-toggle__chip {
      padding-inline: var(--space-2);
    }
  }
</style>
