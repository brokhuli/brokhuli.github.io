---
/*
 * ThemeToggle — segmented control switching between Dark Mode and Eric Mode.
 *
 * Specs:
 *   references/specs/component-spec.md §5 ThemeToggle
 *   references/specs/interaction-spec.md §7
 *
 * Initial theme is set synchronously by the inline <script is:inline> in
 * BaseLayout; this component only handles user clicks and persistence.
 */

import Icon from "../primitives/Icon.astro";
---

<fieldset class="theme-toggle" data-theme-toggle>
  <legend class="sr-only">Theme</legend>

  <label class="theme-toggle__option">
    <input
      type="radio"
      name="theme"
      value="dark"
      class="theme-toggle__input"
      aria-describedby="theme-tip-dark"
    />
    <span class="theme-toggle__chip">
      <Icon name="lucide:moon" size={14} />
      <span class="theme-toggle__label">Dark Mode</span>
    </span>
    <span id="theme-tip-dark" role="tooltip" class="theme-toggle__tip">
      For late-night systems thinking.
    </span>
  </label>

  <label class="theme-toggle__option">
    <input
      type="radio"
      name="theme"
      value="light"
      class="theme-toggle__input"
      aria-describedby="theme-tip-light"
    />
    <span class="theme-toggle__chip">
      <Icon name="lucide:sun" size={14} />
      <span class="theme-toggle__label">Eric Mode</span>
    </span>
    <span id="theme-tip-light" role="tooltip" class="theme-toggle__tip">
      For daylight clarity.
    </span>
  </label>
</fieldset>

<script>
  // Theme toggle behavior. The initial theme is set by the inline
  // theme-init script in BaseLayout; this script only:
  //   1. syncs the radio's checked state from data-theme on mount, and
  //   2. writes data-theme + localStorage.theme on user change.
  // Spec: interaction-spec.md §7.
  (function () {
    const root = document.documentElement;
    const fieldsets = document.querySelectorAll<HTMLFieldSetElement>(
      "[data-theme-toggle]",
    );
    if (fieldsets.length === 0) return;

    const sync = (theme: string) => {
      for (const fs of fieldsets) {
        const inputs = fs.querySelectorAll<HTMLInputElement>(
          ".theme-toggle__input",
        );
        for (const input of inputs) input.checked = input.value === theme;
      }
    };

    const current = root.dataset.theme === "light" ? "light" : "dark";
    sync(current);

    for (const fs of fieldsets) {
      fs.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement | null;
        if (!target || target.name !== "theme") return;
        const next = target.value === "light" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage unavailable (Safari private mode, etc.) — DOM update is enough.
        }
        sync(next);
      });
    }

    // `t` keyboard shortcut (interaction-spec.md §2) flips the theme; we
    // listen on the document so any focused element outside an input works.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "t" || e.metaKey || e.ctrlKey || e.altKey) return;
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // ignore
      }
      sync(next);
    });
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theme-toggle {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    margin: 0;
    border: var(--line-divider);
    border-radius: var(--radius-pill);
    background: var(--color-surface-1);
  }

  .theme-toggle__option {
    position: relative;
    display: inline-flex;
  }

  .theme-toggle__input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .theme-toggle__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    letter-spacing: var(--tracking-wide);
    transition:
      background-color var(--motion-base) var(--ease-in-out-quad),
      color var(--motion-base) var(--ease-in-out-quad);
  }

  .theme-toggle__input:checked + .theme-toggle__chip {
    background: var(--color-accent);
    color: var(--color-fg-on-accent);
  }

  .theme-toggle__input:focus-visible + .theme-toggle__chip {
    outline: var(--border-width-strong) solid var(--color-accent);
    outline-offset: 2px;
  }

  .theme-toggle__tip {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface-2);
    color: var(--color-fg-default);
    border: var(--line-divider);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-quick) var(--ease-out-quart) 400ms;
    z-index: var(--z-popover);
  }

  .theme-toggle__option:hover .theme-toggle__tip,
  .theme-toggle__input:focus-visible ~ .theme-toggle__tip {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__chip {
      transition-duration: var(--motion-instant);
    }
  }
</style>
