---
/*
 * BaseLayout — wraps every page.
 *
 * Owns:
 *   - <html lang="en">, <head>, <body>
 *   - Inline theme-init script (ADR-003) that sets data-theme
 *     synchronously before first paint to prevent FOUC.
 *   - Tailwind/tokens/global stylesheet imports.
 *   - <SEO /> in <head>.
 *   - Persistent chrome: <Sidebar />, <Footer />.
 *   - Persistent whimsy: <ThemeToggle />, <SystemStatus />, <LogTicker />.
 *   - Inline keyboard-shortcut script (g h | g p | g a | g e | g c | t | ?).
 *
 * Specs:
 *   references/specs/architecture-spec.md §3
 *   references/artifacts/architecture-design-record.md ADR-003
 *   references/specs/component-spec.md §1, §5
 *   references/specs/interaction-spec.md §1, §2, §7
 */

import "../styles/tailwind.css";
import "../styles/global.css";
import SEO from "../components/primitives/SEO.astro";
import Sidebar from "../components/chrome/Sidebar.astro";
import Footer from "../components/chrome/Footer.astro";
import ThemeToggle from "../components/whimsy/ThemeToggle.astro";
import SystemStatus from "../components/whimsy/SystemStatus.astro";
import LogTicker from "../components/whimsy/LogTicker.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  seoType?: "website" | "project";
  showSidebar?: boolean;
  project?: {
    title: string;
    tagline: string;
    publishedAt: Date | string;
    updatedAt?: Date | string;
    tech?: string[];
    coverSrc?: string;
  };
}

const {
  title = "Stephen Ullom — brokhuli.github.io",
  description = "Personal portfolio for Stephen Ullom.",
  canonicalUrl,
  ogImage,
  seoType = "website",
  showSidebar = true,
  project,
} = Astro.props;

// GoatCounter site code: env-driven so dev/CI omit the beacon entirely.
// When the account exists, set PUBLIC_GOATCOUNTER_CODE=<sitecode> in .env
// or in the GitHub Actions deploy workflow.
const goatCounterCode = import.meta.env.PUBLIC_GOATCOUNTER_CODE as
  | string
  | undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      type={seoType}
      project={project}
    />

    {
      /*
      Theme-init: runs synchronously before first paint.
      Reads localStorage.theme, falls back to prefers-color-scheme,
      writes data-theme on <html>, then flips data-theme-ready="true"
      so global.css enables transitions for subsequent changes.
    */
    }
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var themes = [
            "dark",
            "theme-3",
            "theme-5",
            "theme-8",
            "theme-9",
            "light",
          ];
          var prefersLight =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: light)").matches;
          var theme =
            themes.indexOf(stored) >= 0
              ? stored
              : prefersLight
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
        try {
          var storedLines = localStorage.getItem("logTickerLines");
          var n = parseInt(storedLines || "", 10);
          if (!(n >= 0 && n <= 4)) n = 3;
          document.documentElement.dataset.logLines = String(n);
        } catch {
          document.documentElement.dataset.logLines = "3";
        }
        requestAnimationFrame(function () {
          document.documentElement.dataset.themeReady = "true";
        });
      })();
    </script>

    {
      /*
      Keyboard shortcuts (interaction-spec.md §2):
        g h | g p | g a | g e | g c → scroll to anchor
        t → toggle theme (handled inside ThemeToggle script)
        ? → reuse system-status as a shortcuts cheatsheet (deferred)
      One-second window between leader (`g`) and the second key.
      Disabled while inputs are focused.
    */
    }
    <script is:inline>
      (function () {
        var jumpMap = {
          h: "home",
          p: "projects",
          a: "architecture",
          e: "experience",
          c: "contact",
        };
        var leader = false;
        var leaderTimer = null;
        function inEditable(t) {
          if (!t) return false;
          var tag = t.tagName;
          return (
            tag === "INPUT" ||
            tag === "TEXTAREA" ||
            tag === "SELECT" ||
            t.isContentEditable
          );
        }
        document.addEventListener("keydown", function (e) {
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          if (inEditable(e.target)) return;
          if (e.key === "g") {
            leader = true;
            if (leaderTimer) clearTimeout(leaderTimer);
            leaderTimer = setTimeout(function () {
              leader = false;
            }, 1000);
            return;
          }
          if (leader && Object.prototype.hasOwnProperty.call(jumpMap, e.key)) {
            var id = jumpMap[e.key];
            var el = document.getElementById(id);
            if (el) {
              e.preventDefault();
              el.scrollIntoView({ behavior: "smooth", block: "start" });
              try {
                history.replaceState(null, "", "#" + id);
              } catch {
                // History API unavailable (sandboxed iframe etc.) — ignore.
              }
            }
            leader = false;
            if (leaderTimer) clearTimeout(leaderTimer);
            return;
          }
          leader = false;
        });
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    {showSidebar && <Sidebar />}

    <div class="page-header">
      <SystemStatus />
      <ThemeToggle />
    </div>

    <main class:list={["page-main", !showSidebar && "page-main--no-sidebar"]}>
      <slot />
    </main>

    <Footer />

    <LogTicker />

    {
      /*
       * GoatCounter analytics — privacy-respecting, cookie-free (~3 KB).
       * Site code is read from PUBLIC_GOATCOUNTER_CODE at build time.
       * If unset, no script is emitted (no-op stub) so dev + preview don't
       * fire tracking calls. Spec: tech-stack.md §Analytics.
       */
    }
    {
      goatCounterCode && (
        <script
          is:inline
          async
          data-goatcounter={`https://${goatCounterCode}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>

<style is:global>
  .page-main {
    margin-left: calc(var(--space-4) + var(--layout-sidebar-width));
    padding: var(--space-8) var(--space-4);
    max-width: var(--layout-max-width);
  }

  .page-main--no-sidebar {
    margin-left: 0;
    margin-inline: auto;
  }

  .page-header {
    position: fixed;
    top: var(--space-3);
    right: var(--space-3);
    z-index: var(--z-header);
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    max-width: calc(100vw - var(--space-6));
  }

  @media (max-width: 768px) {
    .page-main {
      margin-left: 0;
      /* Sidebar is fixed; page-header now flows in normal order with its
       * own top margin to clear the sidebar, so page-main only needs a
       * small gap below the page-header. */
      padding: var(--space-4) var(--layout-gutter-mobile) var(--space-6);
    }
    .page-header {
      position: static;
      display: flex;
      justify-content: flex-end;
      padding: var(--space-2) var(--layout-gutter-mobile);
      /* Clear the fixed floating sidebar bar above. */
      margin-top: calc(var(--space-12) + var(--space-3));
    }
  }
</style>
