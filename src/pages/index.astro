---
/*
 * Landing page — composition only, no data logic (ADR-004).
 * Each section component reads its own collection.
 * Phase 6 will wire real routes for subpages.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderCard from "../components/sections/HeaderCard.astro";
import HeroCard from "../components/sections/HeroCard.astro";
import AboutCard from "../components/sections/AboutCard.astro";
import SkillsCard from "../components/sections/SkillsCard.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import ArchitectureSection from "../components/sections/ArchitectureSection.astro";
import TechStackCard from "../components/sections/TechStackCard.astro";
import ExperienceCard from "../components/sections/ExperienceCard.astro";
import ContactCard from "../components/sections/ContactCard.astro";
import LogTicker from "../components/whimsy/LogTicker.astro";
import DoNotPressButton from "../components/whimsy/DoNotPressButton.astro";
---

<BaseLayout
  title="Stephen Ullom — Software Architect"
  description="Personal portfolio for Stephen Ullom — software architect specializing in real-time simulation, digital twins, and safety-critical control systems."
>
  <HeaderCard />

  <div class="landing__intro-grid">
    <div class="landing__intro-left">
      <HeroCard />
      <AboutCard />
    </div>
    <div class="landing__intro-right">
      <SkillsCard />
    </div>
  </div>

  <div class="hide-on-mobile"><ProjectsSection /></div>
  <div class="hide-on-mobile"><ArchitectureSection /></div>

  <div class="landing__bottom-grid">
    <div class="bottom-grid__experience hide-on-mobile"><ExperienceCard /></div>
    <div class="bottom-grid__right">
      <TechStackCard />
      <ContactCard />
      <LogTicker />
      <div class="contact-action">
        <DoNotPressButton />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .landing__intro-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-16);
    align-items: start;
  }

  .landing__intro-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-18);
  }

  .landing__bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    align-items: start;
  }
  .landing__intro-right,
  .bottom-grid__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .contact-action {
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 900px) {
    .landing__intro-grid,
    .landing__bottom-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .landing__intro-grid {
      margin-bottom: var(--space-4);
    }
  }
</style>
