---
/*
 * /system-fault — fake observability dashboard.
 * Whimsy idea 4 — opens from the "Do Not Press" chip in the footer.
 *
 * Spec: references/specs/component-spec.md §5 Do Not Press
 *       references/specs/whimsical-elements.md (idea 4)
 *       references/specs/interaction-spec.md §10
 *
 * Server renders a single shape; on load, an inline script regenerates
 * metrics, chart heights, and log lines from candidate pools so each
 * visit feels different. The Download button serializes the rendered
 * state to JSON.
 */

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/primitives/Card.astro";
import SectionHeading from "../components/primitives/SectionHeading.astro";
import BarChart from "../components/primitives/BarChart.astro";
import LineChart from "../components/primitives/LineChart.astro";
import Icon from "../components/primitives/Icon.astro";

const lineEntries = await getCollection("logLines");
const allLogPool = lineEntries.flatMap((e) => e.data.lines);
const faultPool = allLogPool.filter(
  (l) => l.level === "WARN" || l.level === "ERR",
);
const fillerPool = allLogPool.filter(
  (l) => l.level !== "WARN" && l.level !== "ERR",
);

// SSR fallback: a deterministic slice that's still on-brand.
const ssrLines = [...faultPool.slice(0, 8), ...fillerPool.slice(0, 4)].slice(
  0,
  12,
);

// Candidate metric pool — each entry knows how to generate its own value.
type MetricKind = "uptime" | "ratio" | "drift" | "rpm" | "level" | "vibe";
const metricCandidates: Array<{ label: string; kind: MetricKind }> = [
  { label: "Uptime", kind: "uptime" },
  { label: "Pods", kind: "ratio" },
  { label: "Drift", kind: "drift" },
  { label: "Hamster RPM", kind: "rpm" },
  { label: "Coffee level", kind: "level" },
  { label: "Vibes", kind: "vibe" },
  { label: "Snack throughput", kind: "rpm" },
  { label: "Telemetry pods", kind: "ratio" },
  { label: "Magic smoke", kind: "level" },
  { label: "Yak shaver depth", kind: "rpm" },
  { label: "Confidence", kind: "vibe" },
  { label: "Phase lock", kind: "drift" },
];

// SSR metrics — first 6, with neutral placeholder values.
const ssrMetrics = [
  { label: "Uptime", value: "20+ years" },
  { label: "Pods", value: "42 / 42" },
  { label: "Drift", value: "0.0001 ns" },
  { label: "Hamster RPM", value: "2,340" },
  { label: "Coffee level", value: "stable" },
  { label: "Vibes", value: "passing" },
];

// Charts: bar/line + labels are fixed per chart; the script swaps values.
type ChartKind = "bar" | "line";
const chartConfigs: Array<{
  id: string;
  title: string;
  axis: string;
  labels: string[];
  kind: ChartKind;
}> = [
  {
    id: "cpu",
    title: "CPU per node (%)",
    axis: "cluster nodes n0–n5",
    labels: ["n0", "n1", "n2", "n3", "n4", "n5"],
    kind: "bar",
  },
  {
    id: "latency",
    title: "Request latency (ms)",
    axis: "percentiles",
    labels: ["p50", "p75", "p90", "p95", "p99"],
    kind: "line",
  },
  {
    id: "errors",
    title: "Error rate (rps)",
    axis: "last 6 minutes",
    labels: ["−5m", "−4m", "−3m", "−2m", "−1m", "now"],
    kind: "line",
  },
  {
    id: "queue",
    title: "Queue depth",
    axis: "ingress / ready / ack / DLQ",
    labels: ["in", "rdy", "ack", "dlq"],
    kind: "bar",
  },
];

// SSR chart data (stable placeholders that will be replaced on hydration).
const ssrCharts: Record<
  string,
  Array<{ label: string; value: number; tone: "low" | "med" | "high" }>
> = {
  cpu: [
    { label: "n0", value: 42, tone: "low" },
    { label: "n1", value: 71, tone: "med" },
    { label: "n2", value: 88, tone: "high" },
    { label: "n3", value: 24, tone: "low" },
    { label: "n4", value: 63, tone: "med" },
    { label: "n5", value: 37, tone: "low" },
  ],
  latency: [
    { label: "p50", value: 12, tone: "low" },
    { label: "p75", value: 24, tone: "low" },
    { label: "p90", value: 58, tone: "med" },
    { label: "p95", value: 82, tone: "med" },
    { label: "p99", value: 96, tone: "high" },
  ],
  errors: [
    { label: "−5m", value: 3, tone: "low" },
    { label: "−4m", value: 8, tone: "low" },
    { label: "−3m", value: 22, tone: "med" },
    { label: "−2m", value: 67, tone: "high" },
    { label: "−1m", value: 91, tone: "high" },
    { label: "now", value: 14, tone: "med" },
  ],
  queue: [
    { label: "in", value: 84, tone: "med" },
    { label: "rdy", value: 41, tone: "low" },
    { label: "ack", value: 19, tone: "low" },
    { label: "dlq", value: 6, tone: "high" },
  ],
};

const dataPayload = {
  metricCandidates,
  chartConfigs,
  faultPool,
  fillerPool,
};
---

<BaseLayout
  title="System Fault — Stephen Ullom"
  description="Fault detected. The system will recover."
>
  <div class="fault">
    <div class="fault__topbar">
      <a class="fault__return" href="/">← Return to safety</a>
      <button
        type="button"
        class="btn btn--outline fault__download"
        id="fault-download"
      >
        <Icon name="lucide:download" size={16} />
        <span>Download fault report (.json)</span>
      </button>
    </div>

    <Card class="fault__banner" variant="accent">
      <h1 class="fault__heading">
        <span class="fault__tag">FAULT</span>
        Fault detected! The system will recover. In the meantime, here's the observability
        report:
      </h1>
    </Card>

    <section class="fault__metrics">
      <SectionHeading as="h2">Live metrics</SectionHeading>
      <ul class="fault__metric-grid" role="list" data-fault-metrics>
        {
          ssrMetrics.map((m) => (
            <li class="fault__metric">
              <span class="fault__metric-label">{m.label}</span>
              <span class="fault__metric-value">{m.value}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="fault__chart-grid">
      {
        chartConfigs.map((c) => (
          <Card class="fault__chart-card">
            <SectionHeading slot="header" as="h2">
              {c.title}
            </SectionHeading>
            <div data-fault-chart={c.id} data-fault-chart-kind={c.kind}>
              {c.kind === "line" ? (
                <LineChart
                  data={ssrCharts[c.id]}
                  axisLabel={c.axis}
                  height={64}
                />
              ) : (
                <BarChart
                  data={ssrCharts[c.id]}
                  axisLabel={c.axis}
                  height={64}
                />
              )}
            </div>
          </Card>
        ))
      }
    </div>

    <Card>
      <SectionHeading slot="header" as="h2">Recent log lines</SectionHeading>
      <ul
        class="fault__log"
        role="list"
        aria-label="Recent log lines"
        data-fault-log
      >
        {
          ssrLines.map((l) => (
            <li class="fault__log-line">
              <span class="fault__log-level" data-level={l.level}>
                {l.level}
              </span>
              <span class="fault__log-text">{l.text}</span>
            </li>
          ))
        }
      </ul>
    </Card>

    <a class="fault__return fault__return--bottom" href="/"
      >← Return to safety</a
    >
  </div>
</BaseLayout>

<script
  is:inline
  id="fault-data"
  type="application/json"
  set:html={JSON.stringify(dataPayload)}
/>

<script>
  /*
   * Client-side regenerator: picks fresh metrics, chart values, and log
   * lines on each load, then attaches the JSON download handler.
   * Bar charts: swap <rect> heights/y/tone in place to avoid re-running
   * the BarChart component on the client.
   */
  type LogLine = {
    level: "INFO" | "SYS" | "DBG" | "WARN" | "ERR";
    text: string;
    tone: "realistic" | "absurd";
  };
  type MetricKind = "uptime" | "ratio" | "drift" | "rpm" | "level" | "vibe";
  type Payload = {
    metricCandidates: Array<{ label: string; kind: MetricKind }>;
    chartConfigs: Array<{
      id: string;
      title: string;
      axis: string;
      labels: string[];
      kind: "bar" | "line";
    }>;
    faultPool: LogLine[];
    fillerPool: LogLine[];
  };
  type Tone = "low" | "med" | "high";

  const dataNode = document.getElementById("fault-data");
  if (!dataNode) {
    // Nothing to do; SSR fallback is already on screen.
  } else {
    const payload = JSON.parse(dataNode.textContent || "{}") as Payload;

    const rand = (min: number, max: number) =>
      Math.random() * (max - min) + min;
    const randInt = (min: number, max: number) =>
      Math.floor(rand(min, max + 1));
    const pickN = <T,>(arr: T[], n: number): T[] => {
      const copy = [...arr];
      const out: T[] = [];
      while (copy.length > 0 && out.length < n) {
        out.push(copy.splice(randInt(0, copy.length - 1), 1)[0]);
      }
      return out;
    };

    const fmt = {
      uptime: () => {
        const choices = [
          "20+ years",
          "13 days",
          "98.999%",
          "since the Big Bang",
          "1h 22m",
          "since Tuesday",
        ];
        return choices[randInt(0, choices.length - 1)];
      },
      ratio: () => {
        const total = randInt(8, 64);
        const up = Math.max(0, total - randInt(0, 2));
        return `${up} / ${total}`;
      },
      drift: () => {
        const v = rand(0.00001, 0.5).toFixed(5);
        return `${v} ns`;
      },
      rpm: () => `${randInt(1500, 3500).toLocaleString()}`,
      level: () => {
        const choices = ["stable", "rising", "low", "critical", "nominal"];
        return choices[randInt(0, choices.length - 1)];
      },
      vibe: () => {
        const choices = ["passing", "shaky", "immaculate", "TBD", "vibing"];
        return choices[randInt(0, choices.length - 1)];
      },
    } as const;

    const formatMetric = (kind: MetricKind) => fmt[kind]();

    const toneFor = (value: number): Tone =>
      value > 75 ? "high" : value > 40 ? "med" : "low";

    // 1) Metrics
    const chosenMetrics = pickN(payload.metricCandidates, 6).map((m) => ({
      label: m.label,
      value: formatMetric(m.kind),
    }));

    const metricGrid = document.querySelector<HTMLElement>(
      "[data-fault-metrics]",
    );
    if (metricGrid) {
      metricGrid.innerHTML = chosenMetrics
        .map(
          (m) =>
            `<li class="fault__metric"><span class="fault__metric-label">${escapeHtml(m.label)}</span><span class="fault__metric-value">${escapeHtml(m.value)}</span></li>`,
        )
        .join("");
    }

    // 2) Charts: regenerate values; rewrite SVG <rect> heights, y, and tone.
    const chartsState: Record<
      string,
      Array<{ label: string; value: number; tone: Tone }>
    > = {};

    for (const cfg of payload.chartConfigs) {
      const data = cfg.labels.map((label) => {
        const value = randInt(2, 99);
        return { label, value, tone: toneFor(value) };
      });
      chartsState[cfg.id] = data;

      const wrap = document.querySelector<HTMLElement>(
        `[data-fault-chart="${cfg.id}"]`,
      );
      if (!wrap) continue;
      const svg = wrap.querySelector<SVGSVGElement>(".chart__svg");
      if (!svg) continue;

      // Read viewBox to know height.
      const viewBox = svg.getAttribute("viewBox") || "0 0 100 64";
      const vbParts = viewBox.split(/\s+/).map(Number);
      const height = vbParts[3] || 64;
      const max = Math.max(1, ...data.map((d) => d.value));

      if (cfg.kind === "line") {
        const polyline = svg.querySelector<SVGPolylineElement>(".chart__line");
        const circles = svg.querySelectorAll<SVGCircleElement>(".chart__point");
        if (!polyline || circles.length !== data.length) continue;
        const padY = 4;
        const stepX = data.length > 1 ? 100 / (data.length - 1) : 0;
        const points = data.map((d, i) => {
          const x = data.length > 1 ? i * stepX : 50;
          const y = height - padY - (d.value / max) * (height - padY * 2);
          return { x, y, tone: d.tone };
        });
        polyline.setAttribute(
          "points",
          points.map((p) => `${p.x},${p.y}`).join(" "),
        );
        const lastTone = data[data.length - 1].tone;
        polyline.setAttribute("class", `chart__line chart__line--${lastTone}`);
        points.forEach((p, i) => {
          const c = circles[i];
          c.setAttribute("cx", String(p.x));
          c.setAttribute("cy", String(p.y));
          c.setAttribute("class", `chart__point chart__point--${p.tone}`);
        });
      } else {
        const rects = svg.querySelectorAll<SVGRectElement>(".chart__bar");
        if (rects.length !== data.length) continue;
        data.forEach((d, i) => {
          const rect = rects[i];
          const barHeight = (d.value / max) * (height - 16);
          const y = height - barHeight;
          rect.setAttribute("height", String(barHeight));
          rect.setAttribute("y", String(y));
          rect.setAttribute("class", `chart__bar chart__bar--${d.tone}`);
        });
      }
    }

    // 3) Logs: 8–12 mixed WARN/ERR + filler
    const logCount = randInt(8, 12);
    const warnCount = Math.min(payload.faultPool.length, randInt(4, 8));
    const fillerCount = Math.max(0, logCount - warnCount);
    const chosenLogs = [
      ...pickN(payload.faultPool, warnCount),
      ...pickN(payload.fillerPool, fillerCount),
    ].sort(() => Math.random() - 0.5);

    const logEl = document.querySelector<HTMLElement>("[data-fault-log]");
    if (logEl) {
      logEl.innerHTML = chosenLogs
        .map(
          (l) =>
            `<li class="fault__log-line"><span class="fault__log-level" data-level="${l.level}">${l.level}</span><span class="fault__log-text">${escapeHtml(l.text)}</span></li>`,
        )
        .join("");
    }

    // 4) Download handler
    const button = document.getElementById("fault-download");
    if (button) {
      button.addEventListener("click", () => {
        const report = {
          generatedAt: new Date().toISOString(),
          metrics: chosenMetrics,
          charts: chartsState,
          logs: chosenLogs,
        };
        const blob = new Blob([JSON.stringify(report, null, 2)], {
          type: "application/json",
        });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `fault-report-${Date.now()}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }
  }
</script>

<style is:global>
  .fault {
    /* Clear the fixed top-right page-header cluster (SystemStatus + ThemeToggle)
     * so the topbar's right-edge button isn't covered at scroll-top. */
    padding-top: calc(var(--space-8) + var(--space-3));
  }

  @media (max-width: 768px) {
    /* Mobile: page-header is in normal flow (BaseLayout), no overlap to clear. */
    .fault {
      padding-top: 0;
    }
  }

  .fault__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .fault__return {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .fault__return:hover {
    color: var(--color-accent);
  }
  .fault__return--bottom {
    margin-top: var(--space-6);
  }

  .fault__download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    cursor: pointer;
    background: transparent;
    color: var(--color-fg-default);
    border: var(--border-width-strong) solid var(--color-border-strong);
    transition:
      border-color var(--motion-quick) var(--ease-out-quart),
      color var(--motion-quick) var(--ease-out-quart);
  }
  .fault__download:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .fault__banner {
    border-color: var(--color-danger);
    margin-bottom: var(--space-6);
  }

  .fault__heading {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: var(--text-md-line);
    color: var(--color-fg-default);
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .fault__tag {
    display: inline-block;
    background: var(--color-danger);
    color: #ffffff;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    flex-shrink: 0;
  }

  .fault__metrics {
    margin-bottom: var(--space-6);
  }

  .fault__metric-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-2);
  }

  .fault__metric {
    background: var(--color-surface-1);
    border: var(--border-width-strong) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fault__metric-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .fault__metric-value {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    line-height: var(--text-lg-line);
    color: var(--color-fg-default);
    font-variant-numeric: tabular-nums;
  }

  .fault__chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .fault__chart-card.card {
    padding: var(--space-3);
  }

  .fault__log {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-line);
    color: var(--color-fg-muted);
  }

  .fault__log-line {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }

  .fault__log-level {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wider);
    line-height: 1.6;
    color: var(--color-bg);
    flex-shrink: 0;
  }
  .fault__log-level[data-level="WARN"] {
    background: var(--color-warning);
  }
  .fault__log-level[data-level="ERR"] {
    background: var(--color-danger);
  }
  .fault__log-level[data-level="INFO"] {
    background: var(--color-info);
  }
  .fault__log-level[data-level="SYS"] {
    background: var(--color-success);
  }
  .fault__log-level[data-level="DBG"] {
    background: var(--color-debug);
  }
</style>
